                double particleLifeSpan = 20
                double particleLifeSpanVariation = 1
                float particleMass = 1
                float particleMassVariation = 0.8
                float particleSize = 0.01
                float particleSizeVariation = 0
                float3 radialGravityCenter = (0, -0.1, 0)
