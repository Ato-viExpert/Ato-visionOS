            double warmupDuration = 0

            def RealityKitStruct "mainEmitter"
            {
                float3 acceleration = (0, -0.05, 0)
                token animationRepeatMode = "PlayOnce"
                token billboardMode = "Billboard"
                float birthRate = 800
                float birthRateVariation = 1000
                token blendMode = "Alpha"
